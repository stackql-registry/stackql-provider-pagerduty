# Live smoke test credentials - copy to .env (gitignored) and fill in.
# The same variable names the Terraform PagerDuty provider reads.

# REST API token: a General Access REST API key (account-level, Admin role
# required to create) or a User API token. Sent as `Authorization: Token token=...`.
PAGERDUTY_TOKEN=

# Optional. Email address of a valid user on the account. Only needed with a
# General Access (account-level) token for the write operations that PagerDuty
# attributes to a user (incident create/update, notes, snooze, status updates,
# escalation policy, maintenance window and user creation). A User API token
# does not need it. The smoke suite passes it as the `from_email` parameter.
PAGERDUTY_FROM_EMAIL=
